# Workeaser Admin API — exemplo de ambiente (copie para env-pc/admin-api.env)
# NUNCA commitar valores reais.

APP_NAME=workeaser-admin-api
APP_URL=http://localhost:3334
NODE_ENV=production
HOST=0.0.0.0
PORT=3334
APP_KEY=CHANGE_ME_GENERATE_WITH_ace_generate_key

# MySQL (mesmo banco do workeaser-api)
DB_CONNECTION=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=workeaser
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB_NAME=workeaser_local

# Rate limit login admin
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SEC=60
RATE_LIMIT_ADMIN_LOGIN_MAX=10

DRIVE_DISK=local
