# Workeaser API — exemplo de ambiente (copie para env-pc/workeaser-api.env)
# NUNCA commitar valores reais. Gere APP_KEY com: node ace generate:key

APP_NAME=workeaser-api
APP_URL=http://localhost:3333
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
APP_KEY=CHANGE_ME_GENERATE_WITH_ace_generate_key

# MySQL
DB_CONNECTION=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=workeaser
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB_NAME=workeaser_local

# CORS — adicionar a porta do frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:8080

# Rate limit (segundos por slot)
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_SIGNUP=10
RATE_LIMIT_AUTH_FORGOT=10
RATE_LIMIT_AUTH_RESEND=10
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SEC=60
RATE_LIMIT_ADMIN_LOGIN_MAX=10

# Stripe (modo teste: sk_test_...)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET_KEY=whsec_CHANGE_ME

# Plaid
PLAID_CLIENT_ID=CHANGE_ME
PLAID_SECRET_KEY=CHANGE_ME
PLAID_CLIENT_NAME=Workeaser

# Google OAuth (calendário)
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_URI_REDIRECT=http://localhost:3005/api/google/callback

# Exchange / Outlook
EXCHANGE_CLIENT_ID=CHANGE_ME
EXCHANGE_CLIENT_SECRET=CHANGE_ME
EXCHANGE_REDIRECT_URI=http://localhost:3005/api/exchange/callback
EXCHANGE_AUTHORITY=https://login.microsoftonline.com/common

# Docusign
DOCUSIGN_SANDBOX=true
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=CHANGE_ME
DOCUSIGN_USER_ID=CHANGE_ME
DOCUSIGN_API_ACCOUNT_ID=CHANGE_ME

# AdobeSign
ADOBE_SIGN_API=https://api.echosign.com/api/rest/v6
AUTHORIZATION_ADOBE_SIGN=CHANGE_ME
CLIENTID_ADOBE_SIGN=CHANGE_ME

# AWS SES (email)
AWS_ACCESS_KEY=local-dev
AWS_ACCESS_SECRET=local-dev
AWS_REGION=us-east-1
SES_MAIL_FROM=noreply@example.com
SES_MAIL_FROM_NAME=Workeaser

# Mapbox
MAPBOX_API_KEY=pk.CHANGE_ME

# Drive
DRIVE_DISK=local
