# Frontend Next.js — build do fonte com patches
FROM node:22-bullseye-slim AS deps
WORKDIR /app
COPY src/workeaser-frontend/workeaser-management-frontend-main/package.json \
     src/workeaser-frontend/workeaser-management-frontend-main/yarn.lock ./
RUN corepack enable && corepack prepare yarn@1.22.22 --activate && yarn install --frozen-lockfile --non-interactive

FROM node:22-bullseye-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare yarn@1.22.22 --activate
COPY --from=deps /app/node_modules ./node_modules
COPY src/workeaser-frontend/workeaser-management-frontend-main/ .
ARG NEXT_PUBLIC_API_URL=http://172.16.4.26:3333/api
ARG NEXT_PUBLIC_ADMIN_API_URL=http://172.16.4.26:3334/api
ARG NEXT_PUBLIC_MAPBOX_KEY=pk.localdev
ARG NEXT_IGNORE_BUILD_ERRORS=true
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL \
    NEXT_PUBLIC_MAPBOX_KEY=$NEXT_PUBLIC_MAPBOX_KEY \
    NEXT_IGNORE_BUILD_ERRORS=$NEXT_IGNORE_BUILD_ERRORS \
    NEXT_TELEMETRY_DISABLED=1
RUN yarn build

FROM node:22-bullseye-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app
RUN apt-get update && apt-get install -y --no-install-recommends tini wget && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/next.config.js ./
COPY scripts/patch-frontend.sh /tmp/patch-frontend.sh
RUN chmod +x /tmp/patch-frontend.sh && /tmp/patch-frontend.sh
RUN chown -R app:app /app
USER app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:3000/ || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "start"]
