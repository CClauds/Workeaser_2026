flowchart TB
    subgraph Scheduler["adonis5-scheduler (cron) — ⚠️ NÃO ESTÁ RODANDO no container"]
        GINV["GenerateInvoice\n0 2 * * * (2h diária)"]
        OINV["OverdueInvoice\n0 5 * * * * (hora)"]
        PLAID["PlaidReconciliation\n0 */2 * * * (2h)"]
        LGPD["ProcessDataDeletion\n0 3 * * * (3h)"]
        EMAILQ["ProcessEmailQueue\n* * * * * (1min)"]
        WEBQ["ProcessWebhookRetryQueue\n*/5 * * * * (5min)"]
        WAQ["ProcessWhatsappQueue\n* * * * * (1min)"]
        RENEW["RenewContractTask\n0 1 * * * (1h)"]
    end

    subgraph Filas["Filas (tabelas MySQL)"]
        EQ[("email_queue")]
        DLQ[("webhook_dead_letter_queue")]
        WAQ_T[("whatsapp_messages")]
        LGPD_T[("data_deletion_requests")]
    end

